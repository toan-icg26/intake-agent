### 5. PAUSE - take it out of the queue; approving is refused while on hold
$ curl -sS -X POST $API/pauseRun -H "Content-Type: application/json" $LEAD -d "{\"runID\":\"$RUN\",\"reason\":\"checking with Identity and Access first\"}" | jq -M -c
{"@odata.context":"$metadata#Approval","runID":"49d650c9-7cd7-4c1c-aa3d-da83ed84c587","status":"on_hold","proposal":"{\"path\":\"draft_response\",\"owner\":\"identity_access\",\"channel\":\"reply_to_requester\",\"recipient\":\"Oliver Grant\",\"message\":\"Hi Oliver, I unlocked your account - please try again in 5 minutes.\"}"}
$ curl -sS -X POST $API/approveRun -H "Content-Type: application/json" $LEAD -d "{\"runID\":\"$RUN\"}" | jq -M -c ".error | {code, message}"
{"code":"409","message":"run 49d650c9-7cd7-4c1c-aa3d-da83ed84c587 is on_hold; expected awaiting_approval"}

